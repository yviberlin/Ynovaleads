# Optional: Google Places API (Datenquelle "Google Maps")
GOOGLE_PLACES_API_KEY=

# Optional: eigener Pfad zur Datenbank (Standard: data/leadscraper.db)
DATABASE_PATH=

# Obsidian-Kommandozentrale: Pfad zum Tresor-Ordner auf deinem Mac
OBSIDIAN_VAULT_PATH=
# Unterordner für die Leads (Standard: Leads/01 Aktuell)
OBSIDIAN_LEADS_FOLDER=Leads/01 Aktuell

# KI-Bewertung der Leads (Claude von Anthropic), Schlüssel aus console.anthropic.com
ANTHROPIC_API_KEY=
